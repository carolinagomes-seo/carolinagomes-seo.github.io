---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AUTHOR, LANGUAGES } from '../data/author';
import { breadcrumb, pageNode } from '../utils/schema';
import { pageTitle } from '../utils/title';

const title = pageTitle('Contact: SEO and GEO roles and projects');
const description =
	'Get in touch with Ana Carolina Gomes, SEO and GEO specialist, about SEO, Digital PR or brand visibility roles and projects, by email or LinkedIn.';

// Working languages: the ones at C1 or native level
const working = LANGUAGES.filter((l) => l.level === 'native' || l.level === 'C1').map((l) => l.name);

const schema = [
	pageNode(Astro.site, { path: '/contact/', name: 'Contact', description, type: 'ContactPage' }),
	breadcrumb(Astro.site, [
		['Home', '/'],
		['Contact', '/contact/'],
	]),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} schema={schema} />
	</head>
	<body>
		<Header />
		<main id="main" class="page">
			<header class="page-intro">
				<h1>Let's talk</h1>
				<p>I'm always happy to talk about projects where search, content and brand come together.</p>
			</header>

			<dl class="channels">
				<div>
					<dt>Email</dt>
					<dd><a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a></dd>
				</div>
				<div>
					<dt>LinkedIn</dt>
					<dd>
						<a href={AUTHOR.linkedinUrl} target="_blank" rel="noopener noreferrer me">
							{AUTHOR.linkedinUrl.replace(/^https:\/\/www\./, '')}<span class="sr-only"> (opens in a new tab)</span>
						</a>
					</dd>
				</div>
				<div>
					<dt>Based in</dt>
					<dd>{AUTHOR.location} (UTC−3)</dd>
				</div>
				<div>
					<dt>Working languages</dt>
					<dd>{working.join(' and ')}</dd>
				</div>
			</dl>

			<div class="actions">
				<a class="btn" href={AUTHOR.cvUrl} download>Download CV<span class="sr-only"> (PDF)</span></a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Page padding and the intro (.page, .page-intro) come from global.css */

	.channels {
		max-width: 720px;
		margin: 64px 0 0;
		border-top: 1px solid var(--line);
	}

	.channels div {
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr);
		gap: 4px 24px;
		align-items: baseline;
		padding: 24px 0;
		border-bottom: 1px solid var(--line);
	}

	dt {
		color: var(--meta);
		font-size: 14px;
	}

	dd {
		margin: 0;
		color: var(--ink);
		font-size: 20px;
		letter-spacing: -0.01em;
		line-height: 1.4;
		overflow-wrap: anywhere;
	}

	dd a {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
	}

	.actions {
		margin-top: 40px;
	}

	@media (max-width: 767px) {
		.channels {
			margin-top: 32px;
		}

		.channels div {
			grid-template-columns: 1fr;
			padding: 16px 0;
		}

		dd {
			font-size: 17px;
		}

		.actions {
			margin-top: 32px;
		}
	}
</style>
