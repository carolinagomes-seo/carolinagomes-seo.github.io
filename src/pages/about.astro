---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Collapsible from '../components/Collapsible.astro';
import { AUTHOR, EDUCATION, EXPERIENCE, LANGUAGES } from '../data/author';
import { absolute, breadcrumb, ids } from '../utils/schema';
import { pageTitle } from '../utils/title';

const title = pageTitle('About: SEO and GEO specialist');
const description =
	'Ana Carolina Gomes is an SEO & GEO specialist in Belo Horizonte, Brazil, focused on link building, Digital PR and AI-assisted SEO workflows.';

// Numbers row (phones)
const numbers = [
	{ value: '250–300', label: 'links / quarter' },
	{ value: '20+', label: 'partners' },
	{ value: '25%', label: 'lower cost / link' },
];

// ProfilePage: this page is where the author lives. The Person itself is in every page's
// graph (SchemaGraph.astro); here it is only referenced by @id.
const pageUrl = absolute(Astro.site, '/about/');
const schema = [
	{
		'@type': 'ProfilePage',
		'@id': pageUrl,
		url: pageUrl,
		mainEntity: { '@id': ids(Astro.site).person },
		isPartOf: { '@id': ids(Astro.site).website },
	},
	breadcrumb(Astro.site, [
		['Home', '/'],
		['About', '/about/'],
	]),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} schema={schema} />
	</head>
	<body>
		<Header />
		<main id="main" class="page">
			<!-- The page's only H1. Reads "About" on tablet and desktop, hidden visually on phones,
			     where the profile name below takes its place. -->
			<header class="page-intro about-intro">
				<h1>About<span class="sr-only"> Ana Carolina Gomes</span></h1>
			</header>

			<!-- Tablet and desktop -->
			<div class="d-only">

				<div class="layout">
					<div class="story">
						<p>
							I started in marketing and found SEO through content. My first SEO role involved writing
							optimized product content and running on-page audits for a high-traffic e-commerce site,
							which taught me how much small technical fixes and clear writing can affect visibility.
						</p>
						<p>
							Since 2023, I’ve focused on off-page SEO: building media partnerships, running outreach and
							earning high-authority links across international markets. Today, I secure 250–300 links
							per quarter, manage relationships with more than 20 media and affiliate partners, and have
							reduced our average cost per link by 25% through better outreach and negotiation.
						</p>
						<p>
							Some of my favorite work sits between SEO and operations. I built an AI-assisted workflow
							with Claude Code and Python that turns a spreadsheet into ready-to-use content briefs,
							sending AI tools only the data they actually need.
						</p>
						<p>
							Right now, I’m deepening my skills in technical SEO, data analysis (SQL, BigQuery and Looker
							Studio) and Generative Engine Optimization. I’m most interested in work that connects the
							full picture, from content and technical SEO to authority and AI search.
						</p>

						<div class="actions">
							<a class="btn btn-primary" href={AUTHOR.cvUrl} download>Download CV</a>
							<a class="btn" href={AUTHOR.linkedinUrl} rel="me">LinkedIn</a>
						</div>
					</div>

					<aside class="facts">
						<section>
							<h2>Experience</h2>
							<ul class="timeline">
								{
									EXPERIENCE.map((job) => (
										<li>
											<span class="job-role">{job.role}</span>
											<span class="job-meta">
												{job.company}, {job.dates}
											</span>
										</li>
									))
								}
							</ul>
						</section>

						<section>
							<h2>Education</h2>
							<p class="fact">
								<span class="job-role">{EDUCATION.degree}</span>
								<span class="job-meta">{EDUCATION.school}, {EDUCATION.dates}</span>
							</p>
						</section>

						<section>
							<h2>Languages</h2>
							<p class="fact">{LANGUAGES.map((l) => `${l.name} (${l.level})`).join(', ')}</p>
						</section>
					</aside>
				</div>
			</div>

			<!-- Phones -->
			<div class="m-only">
				<div class="m-profile">
					<Image
						src={AUTHOR.photo}
						alt=""
						width={80}
						height={80}
						densities={[1, 2, 3]}
						loading="eager"
					/>
					<div class="m-profile-text">
						<p class="m-name">{AUTHOR.name}</p>
						<span class="m-role">{AUTHOR.jobTitle} · Belo Horizonte</span>
					</div>
				</div>

				<p class="m-summary">
					Almost four years in SEO, focused on off-page: media partnerships, outreach and high-authority
					links across international markets.
				</p>

				<dl class="m-numbers">
					{
						numbers.map((n) => (
							<div>
								<dt>{n.label}</dt>
								<dd>{n.value}</dd>
							</div>
						))
					}
				</dl>

				<div class="m-buttons">
					<a class="btn btn-primary" href={AUTHOR.cvUrl} download>
						<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
						</svg>
						Download CV<span class="sr-only"> (PDF)</span>
					</a>
					<a class="btn" href={AUTHOR.linkedinUrl} target="_blank" rel="noopener noreferrer me">
						LinkedIn<span class="sr-only"> (opens in a new tab)</span>
					</a>
				</div>

				<div class="m-sections">
					<Collapsible title="My story" open>
						<div class="m-story">
							<p>
								I started in marketing and found SEO through content. My first SEO role involved writing
								optimized product content and running on-page audits for a high-traffic e-commerce site,
								which taught me how much small technical fixes and clear writing can affect visibility.
							</p>
							<p>
								Since 2023, I've focused on off-page SEO: building media partnerships, running outreach
								and earning high-authority links across international markets.
							</p>
							<p>
								Some of my favorite work sits between SEO and operations, like an AI-assisted workflow with
								Claude Code and Python that turns a spreadsheet into ready-to-use content briefs.
							</p>
							<p>
								Right now, I'm deepening my skills in technical SEO, data analysis (SQL, BigQuery and
								Looker Studio) and Generative Engine Optimization.
							</p>
						</div>
					</Collapsible>

					<Collapsible title="Experience" summary="4 roles · SEO Off-Page Specialist since Jul 2024">
						<ol class="m-list">
							{
								EXPERIENCE.map((job) => (
									<li>
										<span class="m-item">{job.role}</span>
										<span class="m-item-meta">
											{job.company} · {job.dates}
										</span>
									</li>
								))
							}
						</ol>
					</Collapsible>

					<Collapsible title="Education" summary="CST in Marketing · Estácio, 2022 – 2024">
						<p class="m-edu">
							<span class="m-item">{EDUCATION.degree}</span>
							<span class="m-item-meta">{EDUCATION.school} · {EDUCATION.dates}</span>
						</p>
					</Collapsible>

					<Collapsible title="Languages" summary="Portuguese, English (C1), Spanish (A1)">
						<ul class="m-langs">
							{LANGUAGES.map((l) => <li>{l.name} ({l.level})</li>)}
						</ul>
					</Collapsible>
				</div>
			</div>
		</main>
		<Footer compact />
	</body>
</html>

<style>
	/* Page padding, the intro and the phone/desktop variants come from global.css */

	/* ---------- Tablet and desktop ---------- */
	.layout {
		display: grid;
		margin-top: 64px;
		grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	.story {
		max-width: var(--prose);
	}

	.story p {
		margin-bottom: 1.3em;
	}

	.facts section + section {
		margin-top: 2.5rem;
	}

	.facts h2 {
		margin-bottom: 1rem;
		padding-bottom: 0.6rem;
		border-bottom: 1px solid var(--line);
		font-size: 1rem;
		letter-spacing: 0;
	}

	.timeline {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.timeline li + li {
		margin-top: 1rem;
	}

	.job-role {
		display: block;
		color: var(--ink);
		font-weight: 500;
		line-height: 1.35;
	}

	.job-meta {
		display: block;
		color: var(--muted);
		font-size: 0.85rem;
	}

	.fact {
		margin: 0;
	}

	.actions {
		margin-top: 2.25rem;
	}

	@media (max-width: 860px) {
		.layout {
			grid-template-columns: 1fr;
		}
	}

	/* ---------- Phones (<768px) ---------- */
	@media (max-width: 767px) {
		/* Profile */
		.m-profile {
			display: flex;
			align-items: center;
			gap: 16px;
		}

		.m-profile :global(img) {
			flex: none;
			width: 80px;
			height: 80px;
			border-radius: 50%;
			object-fit: cover;
			object-position: 45% 30%;
		}

		.m-profile-text {
			display: flex;
			flex-direction: column;
			gap: 2px;
			min-width: 0;
		}

		.about-intro {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.m-profile .m-name {
			margin: 0;
			color: var(--ink);
			font-size: 26px;
			font-weight: 500;
			letter-spacing: -0.02em;
			line-height: 1.15;
		}

		.m-role {
			color: var(--meta);
			font-size: 14px;
			line-height: 1.4;
		}

		.m-summary {
			margin: 20px 0 0;
			color: var(--ink-2);
			font-size: 16px;
			line-height: 1.5;
		}

		/* Numbers */
		.m-numbers {
			display: flex;
			flex-wrap: nowrap;
			gap: 20px;
			margin: 20px 0 0;
		}

		.m-numbers div {
			display: flex;
			flex-direction: column-reverse; /* value above label; <dt> stays first in the HTML */
			min-width: 0;
		}

		.m-numbers div + div {
			padding-left: 20px;
			border-left: 1px solid var(--line);
		}

		.m-numbers dd {
			margin: 0;
			color: var(--ink);
			font-size: 24px;
			font-weight: 500;
			letter-spacing: -0.03em;
			line-height: 1.2;
			white-space: nowrap;
		}

		.m-numbers dt {
			color: var(--meta);
			font-size: 12px;
			line-height: 1.4;
		}

		/* Buttons */
		.m-buttons {
			display: flex;
			gap: 12px;
			margin-top: 24px;
		}

		.m-buttons .btn {
			flex: 1;
			gap: 8px;
			min-width: 0;
			padding: 0 16px;
			font-size: 15px;
		}

		.m-buttons svg {
			flex: none;
			fill: none;
			stroke: currentColor;
			stroke-width: 2;
			stroke-linecap: round;
			stroke-linejoin: round;
		}

		/* Collapsible sections */
		.m-sections {
			margin-top: 40px;
			border-top: 1px solid var(--line);
		}

		/* Content inside the Collapsible sections */
		.m-list,
		.m-langs,
		.m-edu {
			margin: 0;
		}

		.m-story {
			display: flex;
			flex-direction: column;
			gap: 14px;
		}

		.m-story p {
			margin: 0;
			color: var(--muted);
			font-size: 15px;
			line-height: 1.55;
		}

		.m-list,
		.m-langs {
			padding-left: 0;
			list-style: none;
		}

		.m-list li + li {
			margin-top: 16px;
		}

		.m-item {
			display: block;
			color: var(--ink);
			font-size: 16px;
			font-weight: 500;
			line-height: 1.35;
		}

		.m-item-meta {
			display: block;
			color: var(--meta);
			font-size: 13px;
			line-height: 1.4;
		}

		.m-langs li {
			color: var(--ink);
			font-size: 16px;
			line-height: 1.6;
		}
	}
</style>
