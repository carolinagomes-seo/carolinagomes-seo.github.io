---
// A case study page (only cases with a written body get one). Same reading layout as blog posts.
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { CASE_TYPE_LONG, caseUrl, getCaseStudies, hasPage } from '../../utils/cases';
import { formatDate, isoDate } from '../../utils/date';
import { readingDuration, readingTime, wordCount } from '../../utils/readingTime';
import { absolute, authorRef, breadcrumb, caseStudiesNode, ids } from '../../utils/schema';
import { pageTitle } from '../../utils/title';

export async function getStaticPaths() {
	const cases = (await getCaseStudies()).filter(hasPage);
	return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, seoTitle, description, metaDescription = description, metric, status, tools, pubDate, updatedDate, image, imageAlt, report } = entry.data;
const type = CASE_TYPE_LONG[entry.data.type];
const result = metric ? `${metric.value} ${metric.label}` : status ? `${status.label}: ${status.note}` : '';

// Social / schema image: a 1200px JPG of the case's own image, or the default social image
const shareImage = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;
const share = shareImage
	? {
			src: shareImage.src,
			width: Number(shareImage.attributes.width),
			height: Number(shareImage.attributes.height),
		}
	: { src: '/og-default.png', width: 1200, height: 630 };

// Article + breadcrumb, added to the site graph
const pageUrl = absolute(Astro.site, caseUrl(entry));
const schema = [
	{
		'@type': 'Article',
		'@id': `${pageUrl}#article`,
		headline: title,
		description: metaDescription,
		image: {
			'@type': 'ImageObject',
			url: absolute(Astro.site, share.src),
			width: share.width,
			height: share.height,
		},
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		author: authorRef(Astro.site),
		publisher: { '@id': ids(Astro.site).person },
		mainEntityOfPage: pageUrl,
		isPartOf: { '@id': caseStudiesNode(Astro.site)['@id'] },
		articleSection: type,
		keywords: tools,
		wordCount: wordCount(entry.body),
		timeRequired: readingDuration(entry.body),
		inLanguage: 'en',
	},
	caseStudiesNode(Astro.site),
	breadcrumb(Astro.site, [
		['Home', '/'],
		['Case studies', '/case-studies/'],
		[title, caseUrl(entry)],
	]),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={pageTitle(seoTitle ?? title)}
			description={metaDescription}
			image={share.src}
			imageWidth={share.width}
			imageHeight={share.height}
			imageAlt={imageAlt}
			type="article"
			article={{ publishedTime: pubDate, modifiedTime: updatedDate ?? pubDate }}
			schema={schema}
		/>
	</head>
	<body>
		<Header />
		<main id="main" class="case">
			<nav class="crumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/case-studies/">Case studies</a></li>
					<li><span aria-hidden="true">›</span> {type}</li>
				</ol>
			</nav>

			<h1>{title}</h1>
			<p class="lede">{description}</p>

			<dl class="facts">
				{
					result && (
						<div>
							<dt>Result</dt>
							<dd>{result}</dd>
						</div>
					)
				}
				<div>
					<dt>Tools</dt>
					<dd>{tools.join(', ')}</dd>
				</div>
				<div>
					<dt>Published</dt>
					<dd>
						<time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time> · {readingTime(entry.body)} min read
						{
							updatedDate && (
								<>
									{' '}
									· Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
								</>
							)
						}
					</dd>
				</div>
			</dl>

			{
				report && (
					<p class="report">
						<a class="btn btn-primary" href={report} download>
							Download the full case study<span class="sr-only"> (PDF)</span>
						</a>
					</p>
				)
			}

			<article class="prose body">
				<Content />
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.case {
		padding-bottom: 64px;
	}

	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		color: var(--meta);
		font-size: 14px;
		list-style: none;
	}

	.crumbs a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	h1 {
		max-width: 880px;
		margin: 24px 0 0;
		font-size: 56px;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.lede {
		max-width: 720px;
		margin: 24px 0 0;
		color: var(--muted);
		font-size: 20px;
		line-height: 1.5;
	}

	/* Facts bar: same lines as a blog post's byline */
	.facts {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
		margin: 32px 0 0;
		padding: 24px 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.facts dt {
		color: var(--meta);
		font-size: 13px;
	}

	.facts dd {
		margin: 4px 0 0;
		color: var(--ink);
		font-size: 15px;
		line-height: 1.45;
	}

	.report {
		margin: 32px 0 0;
	}

	.body {
		max-width: 680px;
		margin: 64px auto 0;
	}

	@media (max-width: 1023px) {
		h1 {
			font-size: 44px;
		}

		.body {
			max-width: none;
		}
	}

	@media (max-width: 767px) {
		.case {
			padding-top: 24px;
			padding-bottom: 0;
		}

		h1 {
			font-size: 32px;
		}

		.lede {
			font-size: 17px;
		}

		.facts {
			grid-template-columns: 1fr;
			gap: 16px;
		}

		.report .btn {
			width: 100%;
		}

		.body {
			margin-top: 40px;
		}
	}
</style>
