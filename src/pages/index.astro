---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPosts, postUrl } from '../utils/posts';
import { Image } from 'astro:assets';
import portrait from '../assets/ana-carolina-gomes-color.jpg';
import { formatDate, isoDate } from '../utils/date';
import { AUTHOR } from '../data/author';
import { pageNode } from '../utils/schema';
import { pageTitle } from '../utils/title';

const title = pageTitle('SEO and brand visibility specialist');
const description =
	'How brands get found, trusted and cited in search: projects and notes from practice by Ana Carolina Gomes, SEO specialist in Belo Horizonte, Brazil.';

const EMAIL = AUTHOR.email;
const LINKEDIN = AUTHOR.linkedinUrl;

const work = [
	{
		href: '/case-studies/',
		label: 'Professional work · 2023 to now',
		title: 'SEO in international, high-competition markets',
		description:
			'Link building and Digital PR at the core: an outreach and media partnership program across international markets, balancing link quality with acquisition cost. Around it, content and on-page work, plus AI-assisted workflows built with Claude Code and Python.',
		// Shorter copy for phones
		mobileDescription:
			'Link building and Digital PR at the core, plus content, on-page and AI-assisted workflows.',
		areas: 'Link building · Digital PR · Content · On-page · AI workflows',
		metric: '250+',
		metricLabel: 'links per quarter, 25% lower cost per link',
	},
	{
		href: '/case-studies/greensip-mini-capstone/',
		label: 'Course project',
		title: 'GreenSip: an answer-ready article on a YMYL topic',
		description:
			'Keyword strategy, AI-assisted writing and schema markup for "green tea for weight loss", built for a fictional wellness brand to practice content that search engines and AI tools can trust.',
		metric: '66.5k',
		metricLabel: 'monthly US searches in a 6-keyword cluster; schema with zero errors',
	},
];

// This page, about the author (the Person entity itself is on the About page)
const schema = [pageNode(Astro.site, { path: '/', name: title, description })];

// The two latest published posts (drafts excluded), on every breakpoint
const latest = (await getPosts()).slice(0, 2);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} schema={schema} />
	</head>
	<body>
		<Header />
		<main id="main" class="home">
			<!-- Hero (on phones: author row, headline, short intro, buttons) -->
			<section class="container hero" aria-labelledby="hero-title">
				<div class="hero-text">
					<div class="m-author m-only">
						<Image
							src={portrait}
							alt="Ana Carolina Gomes"
							width={48}
							height={48}
							densities={[1, 2, 3]}
							loading="eager"
						/>
						<div class="m-author-text">
							<span class="m-author-name">Ana Carolina Gomes</span>
							<span class="m-author-role">SEO &amp; GEO Specialist</span>						</div>
					</div>
					<p class="eyebrow d-only">Ana Carolina Gomes · SEO &amp; GEO Specialist · Belo Horizonte, Brazil</p>
					<h1 id="hero-title">How brands get found, trusted and cited in search.</h1>
					<p class="intro d-only">
						In almost four years of SEO, I’ve worked across content, on-page and off-page, mostly in
						international, high-competition markets. Links, mentions and clear content shape which
						brands AI tools choose to cite.
					</p>
					<p class="intro m-only">
						Almost four years of SEO in international, high-competition markets: content, on-page and
						off-page.
					</p>
					<div class="actions hero-actions">
						<a class="btn btn-primary" href="/case-studies/">See my work</a>
						<a class="btn" href="/blog/">Read the blog</a>
					</div>
				</div>

				<figure class="portrait d-only">
					<Image
						src={portrait}
						alt="Ana Carolina Gomes, SEO specialist"
						width={456}
						height={528}
						widths={[416, 456, 768, 912, 1200]}
						sizes="(max-width: 1023px) calc(100vw - 96px), (min-width: 1600px) 456px, (min-width: 1280px) 416px, 360px"
						loading="eager"
						fetchpriority="high"
					/>				</figure>
			</section>

			<!-- From the blog (phones only; wider screens show "Latest notes" further down) -->
			{
				latest.length > 0 && (
					<section class="container m-blog m-only" aria-labelledby="m-blog-title">
						<div class="m-head">
							<h2 id="m-blog-title">From the blog</h2>
							<a class="m-head-link" href="/blog/">
								All posts
								<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M5 12h14M13 6l6 6-6 6" />
								</svg>
							</a>
						</div>
						<ul class="m-posts">
							{latest.map((post) => (
								<li>
									<a class="m-post" href={postUrl(post)}>
										<Image
											src={post.data.image}
											alt=""
											width={88}
											height={64}
											densities={[1, 2, 3]}
											loading="lazy"
										/>
										<span class="m-post-text">
											<span class="m-post-meta">
												{post.data.category} ·{' '}
												<time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
											</span>
											<span class="m-post-title">{post.data.title}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<!-- Selected work -->
			<section class="container block work-block" aria-labelledby="work-title">
				<div class="block-inner">
					<div class="block-head">
						<h2 id="work-title">Selected work</h2>
						<p class="d-only">
							What I do day to day, and a project from my studies: the problem, what I did and what
							came out of it.
						</p>
						<a class="m-head-link m-only" href="/case-studies/">
							All work
							<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M5 12h14M13 6l6 6-6 6" />
							</svg>
						</a>
					</div>
					<div class="block-body">
						<ul class="work">
							{
								work.map((item) => (
									<li>
										<a class="work-item" href={item.href}>
											<div class="work-text">
												<span class="label">{item.label}</span>
												<h3 class="item-title">{item.title}</h3>
												<span class:list={['desc', { 'd-only': item.mobileDescription }]}>{item.description}</span>
												{item.mobileDescription && <span class="desc m-only">{item.mobileDescription}</span>}
												{item.areas && <span class="areas d-only">{item.areas}</span>}
											</div>
											<div class="work-metric">
												<span class="metric">{item.metric}</span>
												<span class="metric-label">{item.metricLabel}</span>
											</div>
										</a>
									</li>
								))
							}
						</ul>
						<a class="text-link d-only" href="/case-studies/">All work</a>
					</div>
				</div>
			</section>

			<!-- Latest notes (tablet and desktop) -->
			<section class="container block d-only" aria-labelledby="notes-title">
				<div class="block-inner">
					<div class="block-head">
						<h2 id="notes-title">Latest notes</h2>
						<p>Practical writing on SEO, GEO, link building and AI workflows.</p>
					</div>
					<div class="block-body">
						<ul class="notes">
							{
								latest.map((post) => (
									<li>
										<a class="note" href={postUrl(post)}>
											<Image
												class="note-img"
												src={post.data.image}
												alt=""
												widths={[160, 208, 320, 416]}
												sizes="(max-width: 1023px) 160px, 208px"
												loading="lazy"
											/>
											<div class="note-text">
												<span class="note-meta">
													<time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
												</span>
												<h3 class="item-title">{post.data.title}</h3>
												<span class="desc">{post.data.description}</span>
											</div>
										</a>
									</li>
								))
							}
						</ul>
						<a class="text-link" href="/blog/">All posts</a>
					</div>
				</div>
			</section>

			<!-- Get in touch (a card on wider screens, a plain list on phones) -->
			<section class="container contact-wrap" aria-labelledby="contact-title">
				<div class="contact">
					<div>
						<h2 id="contact-title">Get in touch</h2>
						<p class="d-only">
							A project in SEO or brand visibility, or just want to compare notes? Email or LinkedIn is
							the best way to reach me.
						</p>
						<p class="m-only">A project, or just to compare notes.</p>
					</div>

					<div class="contact-actions d-only">
						<div class="email-field">
							<span class="email">{EMAIL}</span>
							<button class="copy" type="button" data-copy={EMAIL} data-copy-done="Email address copied">
								Copy
							</button>
						</div>
						<div class="contact-buttons">
							<a class="btn btn-primary" href={`mailto:${EMAIL}`}>Email me</a>
							<a class="btn" href={LINKEDIN} target="_blank" rel="noopener me">LinkedIn</a>
						</div>
					</div>

					<ul class="m-contact m-only">
						<li class="m-row">
							<a class="m-row-main" href={`mailto:${EMAIL}`}>
								<span class="m-row-label">Email</span>
								<span class="m-row-value">{EMAIL}</span>
							</a>
							<button
								class="m-copy"
								type="button"
								aria-label="Copy email address"
								data-copy={EMAIL}
								data-copy-done="Email copied"
							>
								<svg class="icon-copy" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
									<rect x="9" y="9" width="11" height="11" rx="2" />
									<path d="M5 15V6a2 2 0 0 1 2-2h9" />
								</svg>
								<svg class="icon-check" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M5 12.5 10 17l9-10" />
								</svg>
							</button>
						</li>
						<li>
							<a class="m-row m-row-link" href={LINKEDIN} target="_blank" rel="noopener me">
								<span class="m-row-main">
									<span class="m-row-label">LinkedIn</span>
									<span class="m-row-value">Ana Carolina Gomes</span>
								</span>
								<span class="sr-only">(opens in a new tab)</span>
								<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M7 17 17 7M9 7h8v8" />
								</svg>
							</a>
						</li>
					</ul>
					<span class="sr-only" aria-live="polite" data-copy-status></span>
				</div>
			</section>
		</main>
		<Footer compact />

		<script>
			// Copy the email address. The desktop button shows "Copied" and the phone button a check,
			// both for 2 seconds; screen readers hear the message in data-copy-done.
			const status = document.querySelector<HTMLElement>('[data-copy-status]');
			document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
				const label = button.textContent?.trim() ?? '';
				let timer: number | undefined;
				button.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(button.dataset.copy ?? '');
						button.dataset.copied = 'true';
						if (label) button.textContent = 'Copied';
						if (status) status.textContent = button.dataset.copyDone ?? 'Copied';
						window.clearTimeout(timer);
						timer = window.setTimeout(() => {
							delete button.dataset.copied;
							if (label) button.textContent = label;
							if (status) status.textContent = '';
						}, 2000);
					} catch {
						if (status) status.textContent = 'Could not copy. Select the address to copy it.';
					}
				});
			});
		</script>
	</body>
</html>

<style>
	/* ---------- Page ---------- */
	.home {
		max-width: none;
		margin: 0;
		padding: 0;
	}

	h2 {
		margin: 0;
	}

	/* .m-only / .d-only (phone and wider-screen variants) come from global.css */

	.desc {
		color: var(--muted);
		font-size: 16px;
		line-height: 1.5;
	}

	.item-title {
		margin: 0;
		color: var(--ink);
		font-size: 24px;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.25;
		text-underline-offset: 4px;
	}

	.text-link {
		display: inline-block;
		margin-top: 32px;
		color: var(--ink);
		font-size: 15px;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* ---------- Hero ---------- */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 416px;
		gap: 96px;
		align-items: center;
		padding-top: 96px;
	}

	.hero-text {
		min-width: 0;
	}

	.eyebrow {
		margin: 0 0 16px;
		color: var(--meta);
		font-size: 15px;
		line-height: 1.5;
	}

	h1 {
		margin: 0;
		color: var(--ink);
		font-size: 64px;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.intro {
		max-width: 520px;
		margin: 24px 0 0;
		color: var(--ink-2);
		font-size: 18px;
		line-height: 1.5;
	}

	.hero-actions {
		margin-top: 32px;
	}

	.portrait {
		position: relative;
		height: 480px;
		margin: 0;
	}

	.portrait :global(img) {
		width: 100%;
		height: 100%;
		border-radius: 24px;
		object-fit: cover;
		object-position: 45% 30%;
	}

	/* ---------- Sections (Selected work, Latest notes) ---------- */
	.block {
		margin-top: 128px;
	}

	.block-inner {
		display: grid;
		grid-template-columns: 288px minmax(0, 1fr);
		gap: 64px;
		padding-top: 48px;
		border-top: 1px solid var(--line);
	}

	.block-head h2 {
		color: var(--ink);
		font-size: 32px;
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.block-head p {
		margin: 16px 0 0;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.5;
	}

	.block-body {
		min-width: 0;
	}

	/* Work items */
	.work,
	.notes {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.work-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 208px;
		gap: 48px;
		color: inherit;
		text-decoration: none;
	}

	.work li:first-child .work-item {
		padding-bottom: 32px;
		border-bottom: 1px solid var(--line);
	}

	.work li + li .work-item {
		padding-top: 32px;
	}

	.work-text {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}

	.label {
		color: var(--meta);
		font-size: 13px;
		line-height: 1.5;
	}

	.areas {
		color: var(--meta);
		font-size: 14px;
		line-height: 1.5;
	}

	.work-metric {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding-left: 24px;
		border-left: 1px solid var(--line);
	}

	.metric {
		color: var(--ink);
		font-size: 48px;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.metric-label {
		color: var(--meta);
		font-size: 14px;
		line-height: 1.5;
	}

	.work-item:hover .item-title,
	.note:hover .item-title {
		text-decoration: underline;
	}

	/* Latest notes */
	.notes li + li {
		margin-top: 32px;
	}

	.note {
		display: flex;
		align-items: flex-start;
		gap: 32px;
		color: inherit;
		text-decoration: none;
	}

	.note :global(.note-img) {
		flex: none;
		width: 208px;
		height: 136px;
		border-radius: 8px;
		object-fit: cover;
	}

	.note-text {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}

	.note-meta {
		color: var(--meta);
		font-size: 13px;
		line-height: 1.5;
	}

	/* ---------- Get in touch ---------- */
	.contact-wrap {
		margin-top: 128px;
	}

	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 416px;
		gap: 64px;
		align-items: end;
		padding: 64px;
		border-radius: 24px;
		background: var(--surface);
	}

	.contact h2 {
		color: var(--ink);
		font-size: 48px;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.contact p {
		max-width: 496px;
		margin: 16px 0 0;
		color: var(--muted);
		font-size: 18px;
		line-height: 1.5;
	}

	.contact-actions {
		display: flex;
		flex-direction: column;
		gap: 16px;
		min-width: 0;
	}

	.email-field {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 56px;
		padding: 0 4px 0 24px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--bg);
	}

	.email {
		min-width: 0;
		overflow: hidden;
		color: var(--ink);
		font-size: 16px;
		text-overflow: ellipsis;
		white-space: nowrap;
		user-select: all;
	}

	.copy {
		flex: none;
		height: 48px;
		padding: 0 24px;
		border: 0;
		border-radius: 999px;
		background: var(--ink);
		color: #fafaf8;
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		cursor: pointer;
	}

	.contact-buttons {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	/* ---------- Large and widescreen (≥1600px) ---------- */
	@media (min-width: 1600px) {
		h1 {
			font-size: 72px;
		}

		.hero {
			grid-template-columns: minmax(0, 1fr) 456px;
			gap: 128px;
		}

		.portrait {
			height: 528px;
		}

		.block-inner {
			grid-template-columns: 320px minmax(0, 1fr);
		}
	}

	/* ---------- Small desktop / laptop (1024–1279px) ---------- */
	@media (max-width: 1279px) {
		h1 {
			font-size: 56px;
		}

		.hero {
			grid-template-columns: minmax(0, 1fr) 360px;
			gap: 64px;
		}

		.portrait {
			height: 440px;
		}

		.block-inner {
			grid-template-columns: 240px minmax(0, 1fr);
			gap: 48px;
		}

		.work-item {
			grid-template-columns: minmax(0, 1fr) 176px;
			gap: 32px;
		}

		.contact {
			grid-template-columns: minmax(0, 1fr) 360px;
			gap: 48px;
			padding: 48px;
		}
	}

	/* ---------- Tablet (768–1023px) ---------- */
	@media (max-width: 1023px) {
		h1 {
			font-size: 48px;
		}

		.hero {
			grid-template-columns: 1fr;
			gap: 48px;
		}

		.portrait {
			width: 100%;
			height: auto;
			aspect-ratio: 4 / 3;
			max-height: 480px;
		}

		.block,
		.contact-wrap {
			margin-top: 96px;
		}

		.block-inner {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		.block-head h2 {
			font-size: 28px;
		}

		.work-item {
			grid-template-columns: 1fr;
			gap: 0;
		}

		.work-metric {
			margin-top: 16px;
			padding-left: 0;
			border-left: 0;
		}

		.metric {
			font-size: 40px;
		}

		.note {
			gap: 24px;
		}

		.note :global(.note-img) {
			width: 160px;
			height: 104px;
		}

		.contact {
			grid-template-columns: 1fr;
			gap: 32px;
			padding: 48px;
		}

		.contact h2 {
			font-size: 40px;
		}
	}

	/* ---------- Mobile (<768px): its own, shorter layout ---------- */
	@media (max-width: 767px) {
		/* Intro */
		.hero {
			display: block;
			padding-top: 24px;
		}

		.m-author {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.m-author :global(img) {
			flex: none;
			width: 48px;
			height: 48px;
			border-radius: 50%;
			object-fit: cover;
			object-position: 45% 30%;
		}

		.m-author-text {
			display: flex;
			flex-direction: column;
			gap: 2px;
		}

		.m-author-name {
			color: var(--ink);
			font-size: 15px;
			font-weight: 600;
			line-height: 1.3;
		}

		.m-author-role {
			color: var(--meta);
			font-size: 13px;
			line-height: 1.3;
		}

		h1 {
			margin-top: 20px;
			font-size: 32px;
			letter-spacing: -0.03em;
			line-height: 1.1;
		}

		.intro {
			margin-top: 12px;
			font-size: 15px;
			line-height: 1.5;
		}

		.hero-actions {
			flex-wrap: nowrap;
			gap: 12px;
			margin-top: 20px;
		}

		.hero-actions .btn {
			flex: 1;
			min-width: 0;
			padding: 0 16px;
			font-size: 15px;
		}

		/* Shared section header row: title left, link right */
