---
import { Image } from 'astro:assets';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { AUTHOR } from '../../data/author';
import { formatDate, isoDate } from '../../utils/date';
import { getPosts, postUrl, topicSlug } from '../../utils/posts';
import { readingTime } from '../../utils/readingTime';
import { absolute, blogNode, breadcrumb } from '../../utils/schema';
import { pageTitle } from '../../utils/title';

const posts = await getPosts();

const title = pageTitle('SEO and GEO blog: practical guides');
const description =
	'Practical guides to SEO, brand visibility and AI search by Ana Carolina Gomes, with real examples from her work in competitive markets.';
const intro =
	"What I've learned building SEO and brand authority in some of the toughest markets online, explained for anyone who wants to learn SEO.";

// Topics: every category with at least one published post, by post count, then A–Z
const counts = new Map<string, number>();
posts.forEach((post) => counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1));
const topics = [...counts.entries()]
	.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
	.map(([name]) => ({ name, slug: topicSlug(name) }));

// Blog + breadcrumb, added to the site graph
const schema = [
	{
		...blogNode(Astro.site),
		description: intro,
		blogPost: posts.map((post) => {
			const url = absolute(Astro.site, postUrl(post));
			return {
				'@type': 'BlogPosting',
				'@id': `${url}#article`,
				headline: post.data.title,
				url,
				datePublished: post.data.pubDate.toISOString(),
			};
		}),
	},
	breadcrumb(Astro.site, [
		['Home', '/'],
		['Blog', '/blog/'],
	]),
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} schema={schema} />
	</head>
	<body>
		<Header />
		<main id="main" class="page">
			<header class="page-intro">
				<h1>Blog</h1>
				<p class="d-only">{intro}</p>
				<p class="m-only">
					What I've learned building SEO and brand authority in tough markets, explained for anyone
					learning SEO.
				</p>
			</header>

			<div class="meta-row">
				<a class="author" href={AUTHOR.aboutUrl}>
					<Image src={AUTHOR.photo} alt="" width={48} height={48} densities={[1, 2, 3]} />
					<span class="author-text">
						<span class="author-name">{AUTHOR.name}</span>
						<span class="author-role">{AUTHOR.jobTitle}</span>
					</span>
				</a>

				<button class="topics-toggle" type="button" aria-expanded="false" aria-controls="topics-panel" data-topics-toggle>
					Topics
					<span class="selected-count" data-selected-count hidden></span>
					<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
						<path d="M2.5 4.5 6 8l3.5-3.5" />
					</svg>
				</button>
			</div>

			<!-- Opens inline (never over the posts). Hidden until opened or until ?topics= is set. -->
			<div id="topics-panel" class="panel" role="group" aria-label="Filter posts by topic" hidden>
				{
					topics.map((topic) => (
						<button class="topic" type="button" aria-pressed="false" data-topic={topic.slug}>
							<svg class="check" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
								<path d="M2 6.5 4.8 9 10 3" />
							</svg>
							<span class="topic-name">{topic.name}</span>
						</button>
					))
				}
				<span class="divider" aria-hidden="true" data-clear-part hidden></span>
				<button class="clear" type="button" data-clear data-clear-part hidden>Clear</button>
			</div>
			<p class="sr-only" aria-live="polite" data-topics-status></p>

			<ul class="posts">
				{
					posts.map((post, i) => (
						<li data-category={topicSlug(post.data.category)}>
							<article class="post">
								<div class="post-card">
									<Image
										class="post-img"
										src={post.data.image}
										alt=""
										widths={[88, 176, 208, 264, 416]}
										sizes="(max-width: 767px) 88px, 208px"
										loading={i === 0 ? 'eager' : 'lazy'}
									/>
									<div class="post-text">
										<p class="post-meta">
											{post.data.category} · <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time> ·{' '}
											{readingTime(post.body)} min<span class="d-only"> read</span>
										</p>
										<h2 class="post-title">
											<a class="stretched-link" href={postUrl(post)}>
												{post.data.title}
											</a>
										</h2>
										<p class="post-desc">{post.data.description}</p>
										<span class="read d-only" aria-hidden="true">
											Read article
											<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
												<path d="M5 12h14M13 6l6 6-6 6" />
											</svg>
										</span>
									</div>
								</div>
							</article>
						</li>
					))
				}
			</ul>
		</main>
		<Footer compact mobileGap={24} />

		<script>
			// Topic filter (multi-select). Every post is in the HTML; filtering only toggles `hidden`.
			// The selection is kept in ?topics=a,b so filtered views can be linked.
			const toggle = document.querySelector<HTMLButtonElement>('[data-topics-toggle]');
			const panel = document.getElementById('topics-panel');
			const countLabel = document.querySelector<HTMLElement>('[data-selected-count]');
			const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic]'));
			const clearParts = Array.from(document.querySelectorAll<HTMLElement>('[data-clear-part]'));
			const clear = document.querySelector<HTMLButtonElement>('[data-clear]');
			const rows = Array.from(document.querySelectorAll<HTMLElement>('.posts > li'));
			const status = document.querySelector<HTMLElement>('[data-topics-status]');

			if (toggle && panel) {
				const valid = new Set(buttons.map((b) => b.dataset.topic));
				let selected = new Set<string>();

				const setOpen = (open: boolean) => {
					panel.hidden = !open;
					toggle.setAttribute('aria-expanded', String(open));
				};

				const render = (announce: boolean) => {
					buttons.forEach((b) => b.setAttribute('aria-pressed', String(selected.has(b.dataset.topic ?? ''))));
					clearParts.forEach((el) => (el.hidden = selected.size === 0));
					if (countLabel) {
						countLabel.hidden = selected.size === 0;
						countLabel.textContent = `(${selected.size} selected)`;
					}
					let shown = 0;
					rows.forEach((row) => {
						row.hidden = selected.size > 0 && !selected.has(row.dataset.category ?? '');
						if (!row.hidden) shown++;
					});
					if (announce && status) status.textContent = `${shown} ${shown === 1 ? 'post' : 'posts'} shown`;
				};

				const saveToUrl = () => {
					const url = new URL(window.location.href);
					if (selected.size) url.searchParams.set('topics', [...selected].join(','));
					else url.searchParams.delete('topics');
					history.replaceState(null, '', url);
				};

				const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

				toggle.addEventListener('click', () => setOpen(!isOpen()));

				buttons.forEach((b) =>
					b.addEventListener('click', () => {
						const topic = b.dataset.topic ?? '';
						if (selected.has(topic)) selected.delete(topic);
						else selected.add(topic);
						render(true);
						saveToUrl();
					}),
				);

				clear?.addEventListener('click', () => {
					selected.clear();
					render(true);
					saveToUrl();
					buttons[0]?.focus(); // "Clear" hides itself, so keep focus in the panel
				});

				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && isOpen()) {
						setOpen(false);
						toggle.focus();
					}
				});

				// Read ?topics= on load; open the panel if anything is selected
				const fromUrl = (new URLSearchParams(window.location.search).get('topics') ?? '')
					.split(',')
					.filter((t) => valid.has(t));
				selected = new Set(fromUrl);
				render(false);
				if (selected.size) setOpen(true);
			}
		</script>
	</body>
</html>

<style>
	/* Page padding, the intro and the phone/desktop variants come from global.css */

	/* ---------- Author + Topics row ---------- */
	.meta-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-top: 24px;
	}

	.author {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: inherit;
		text-decoration: none;
	}

	.author :global(img) {
		flex: none;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		object-fit: cover;
	}

	.author-text {
		display: flex;
		flex-direction: column;
	}

	.author-name {
		color: var(--ink);
		font-size: 16px;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.author-role {
		color: var(--meta);
		font-size: 14px;
	}

	.topics-toggle {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 44px;
		padding: 0;
		border: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		font-size: 15px;
		font-weight: 600;
		cursor: pointer;
	}

	.selected-count {
		color: var(--meta);
		font-weight: 400;
	}

	.topics-toggle svg,
	.check {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.topics-toggle[aria-expanded='true'] svg {
		transform: rotate(180deg);
	}

	/* ---------- Topics panel (inline, pushes the list down) ---------- */
	.panel {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 4px 24px;
		margin-top: 16px;
		padding: 16px 0;
		border-top: 1px solid var(--line-soft);
	}

	.panel[hidden],
	.panel [hidden] {
		display: none;
	}

	.topic {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 40px;
		padding: 0;
		border: 0;
		background: none;
		color: var(--meta);
		font: inherit;
		font-size: 15px;
		font-weight: 400;
		cursor: pointer;
	}

	.topic:hover {
		color: var(--ink);
	}

	.check {
		display: none;
	}

	.topic[aria-pressed='true'] {
		color: var(--ink);
		font-weight: 600;
	}

	.topic[aria-pressed='true'] .check {
		display: block;
	}

	.topic[aria-pressed='true'] .topic-name {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
	}

	.divider {
		width: 1px;
		height: 20px;
		background: var(--chip-border);
	}

	.clear {
		height: 40px;
		padding: 0;
		border: 0;
		background: none;
		color: var(--ink);
		font: inherit;
		font-size: 15px;
		cursor: pointer;
	}

	/* ---------- Post list ---------- */
	.posts {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
		list-style: none;
	}

	/* 48px above the list while the panel is closed; none when it's open */
	.panel[hidden] ~ .posts {
		margin-top: 48px;
	}

	.posts > li[hidden] {
		display: none;
	}

	.post {
		padding: 40px 0;
		border-bottom: 1px solid var(--line);
	}

	.post-card {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 32px;
		color: inherit;
		text-decoration: none;
	}

	.post-card :global(.post-img) {
		flex: none;
		width: 208px;
		height: 136px;
		border-radius: 8px;
		object-fit: cover;
	}

	.post-text {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
		max-width: 640px;
	}

	.post-text p {
		margin: 0;
	}

	.post-meta {
		color: var(--meta);
		font-size: 13px;
		line-height: 1.5;
	}

	.post-title {
		margin: 0;
		color: var(--ink);
		font-size: 24px;
		font-weight: 500;
		letter-spacing: -0.01em;
		line-height: 1.25;
		text-underline-offset: 4px;
	}

	.post-card:hover .post-title {
		text-decoration: underline;
	}

	.post-desc {
		color: var(--muted);
		font-size: 16px;
		line-height: 1.5;
	}

	.read {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-top: 8px;
		color: var(--ink);
		font-size: 15px;
		font-weight: 600;
	}

	.read svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* ---------- <768px ---------- */
	@media (max-width: 767px) {
		.page-intro h1 {
			font-size: 32px;
			line-height: 1.1;
		}

		.page-intro p {
			margin-top: 12px;
			font-size: 15px;
			line-height: 1.5;
		}

		/* Author + Topics stay on one row */
		.meta-row {
			gap: 12px;
			margin-top: 20px;
		}

		.author {
			gap: 10px;
			min-width: 0;
		}

		.author :global(img) {
			width: 40px;
			height: 40px;
			object-position: 45% 30%;
		}

		.author-name {
			font-size: 14px;
			text-underline-offset: 3px;
		}

		.author-role {
			font-size: 12px;
		}

		.topics-toggle {
			flex: none;
			gap: 6px;
		}

		/* Topics panel: inline, left-aligned */
		.panel {
			justify-content: flex-start;
			gap: 0 20px;
			margin-top: 12px;
			padding: 12px 0;
		}

		.topic,
		.clear {
			height: 44px;
		}

		/* List: 24px below the row when the panel is closed, none when open */
		.panel[hidden] ~ .posts {
			margin-top: 24px;
		}

		.post {
			padding: 20px 0;
		}

		.post-card {
			gap: 16px;
		}

		/* Small thumbnail only; no large images on phones */
		.post-card :global(.post-img) {
			width: 88px;
			height: 64px;
			margin-top: 2px;
		}

		.post-text {
			gap: 4px;
		}

		.post-meta {
			font-size: 12px;
		}

		.post-title {
			font-size: 17px;
			letter-spacing: 0;
			line-height: 1.3;
		}

		.post-desc {
			display: -webkit-box;
			overflow: hidden;
			font-size: 14px;
			line-height: 1.45;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
		}
	}
</style>
