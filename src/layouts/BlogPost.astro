---
// Layout for every blog post: breadcrumb, title, byline, cover, table of contents, author box
// and the BlogPosting schema. Author details come from src/data/author.ts, so the visible
// byline and the JSON-LD always match.
import type { MarkdownHeading } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AUTHOR } from '../data/author';
import { formatDate, isoDate } from '../utils/date';
import { postUrl, type Post } from '../utils/posts';
import { pageTitle } from '../utils/title';
import { readingDuration, readingTime, wordCount } from '../utils/readingTime';
import { extractFaq } from '../utils/faq';
import { absolute, authorRef, blogNode, breadcrumb, ids } from '../utils/schema';

interface Props {
	post: Post;
	headings?: MarkdownHeading[];
}

const { post, headings = [] } = Astro.props;
const { title, seoTitle, description, pubDate, updatedDate, category, tags, image, imageAlt, imageCredit, imageCreditUrl } =
	post.data;

const toc = headings.filter((h) => h.depth === 2);
const minutes = readingTime(post.body);

// Social / schema image: a 1200px JPG of the cover
const shareImage = await getImage({ src: image, width: 1200, format: 'jpg' });
const shareWidth = Number(shareImage.attributes.width);
const shareHeight = Number(shareImage.attributes.height);

const pageUrl = absolute(Astro.site, postUrl(post));
const schema: Record<string, unknown>[] = [
	{
		'@type': 'BlogPosting',
		'@id': `${pageUrl}#article`,
		headline: title,
		description,
		image: {
			'@type': 'ImageObject',
			url: absolute(Astro.site, shareImage.src),
			width: shareWidth,
			height: shareHeight,
		},
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		author: authorRef(Astro.site),
		publisher: { '@id': ids(Astro.site).person },
		mainEntityOfPage: pageUrl,
		isPartOf: { '@id': ids(Astro.site).blog },
		articleSection: category,
		...(tags?.length ? { keywords: tags } : {}),
		wordCount: wordCount(post.body),
		timeRequired: readingDuration(post.body),
		inLanguage: 'en',
	},
	blogNode(Astro.site),
	breadcrumb(Astro.site, [
		['Home', '/'],
		['Blog', '/blog/'],
		[title, postUrl(post)],
	]),
];

// FAQPage from the post's "## FAQ" section, when it has one
const faq = extractFaq(post.body);
if (faq.length > 0) {
	schema.push({
		'@type': 'FAQPage',
		'@id': `${pageUrl}#faq`,
		url: pageUrl,
		isPartOf: { '@id': `${pageUrl}#article` },
		mainEntity: faq.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: { '@type': 'Answer', text: item.answer },
		})),
	});
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={pageTitle(seoTitle ?? title)}
			description={description}
			image={shareImage.src}
			imageWidth={shareWidth}
			imageHeight={shareHeight}
			imageAlt={imageAlt}
			type="article"
			article={{ publishedTime: pubDate, modifiedTime: updatedDate ?? pubDate }}
			schema={schema}
		/>
	</head>
	<body>
		<Header />
		<main id="main" class="post">
			<nav class="crumbs" aria-label="Breadcrumb">
				<ol>
					<li><a href="/blog/">Blog</a></li>
					<li><span aria-hidden="true">›</span> {category}</li>
				</ol>
			</nav>

			<h1>{title}</h1>
			<p class="lede">{description}</p>

			<div class="byline">
				<a class="author-link" href={AUTHOR.aboutUrl} rel="author">
					<Image src={AUTHOR.photo} alt="" width={48} height={48} densities={[1, 2, 3]} />
					<span class="author-text">
						<span class="author-name">{AUTHOR.name}</span>
						<span class="author-role">{AUTHOR.jobTitle}</span>
					</span>
				</a>
				<p class="dates">
					Published <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time> · {minutes} min read
					{
						updatedDate && (
							<>
								{' '}
								· Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
							</>
						)
					}
				</p>
			</div>

			<figure class="cover">
				<Image
					src={image}
					alt={imageAlt}
					widths={[680, 1088, 1200, 1600, 2176]}
					sizes="(min-width: 1600px) 1200px, (min-width: 1280px) 1088px, calc(100vw - 2 * var(--pad))"
					loading="eager"
					fetchpriority="high"
				/>
				{
					imageCredit && (
						<figcaption>
							Photo: {imageCreditUrl ? <a href={imageCreditUrl}>{imageCredit}</a> : imageCredit}
						</figcaption>
					)
				}
			</figure>

			<div class="body">
				{
					toc.length > 2 && (
						<details class="toc" open>
							<summary>On this page</summary>
							<ol>
								{toc.map((h) => (
									<li>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ol>
						</details>
					)
				}
				<!-- Phones: start the table of contents collapsed so the article is visible first.
				     Inline so it runs before the first paint (no jump). -->
				<script is:inline>
					if (window.matchMedia('(max-width: 600px)').matches) {
						document.querySelector('.toc')?.removeAttribute('open');
					}
				</script>

				<article class="prose">
					<slot />
				</article>
			</div>

			<aside class="author-box" aria-label="About the author">
				<Image src={AUTHOR.photo} alt="" width={80} height={80} densities={[1, 2, 3]} />
				<div class="box-text">
					<p class="box-label">Written by</p>
					<p class="box-name">{AUTHOR.name}</p>
					<p class="box-role">{AUTHOR.jobTitle} · {AUTHOR.location}</p>
					<p class="box-bio">{AUTHOR.shortBio}</p>
					<p class="box-links">
						<a href={AUTHOR.aboutUrl}>About me</a>
						<a href={AUTHOR.caseStudiesUrl}>Case studies</a>
						<a href={AUTHOR.linkedinUrl} rel="me">LinkedIn</a>
					</p>
				</div>
			</aside>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* ---------- Head ---------- */
	.crumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		color: var(--meta);
		font-size: 14px;
		list-style: none;
	}

	.crumbs a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	h1 {
		max-width: 880px;
		margin: 24px 0 0;
		color: var(--ink);
		font-size: 56px;
		font-weight: 500;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.lede {
		max-width: 720px;
		margin: 24px 0 0;
		color: var(--muted);
		font-size: 20px;
		line-height: 1.5;
	}

	/* ---------- Byline ---------- */
	.byline {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 32px;
		padding: 24px 0;
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.author-link {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: inherit;
		text-decoration: none;
	}

	.author-link :global(img) {
		flex: none;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		object-fit: cover;
	}

	.author-text {
		display: flex;
		flex-direction: column;
	}

	.author-name {
		color: var(--ink);
		font-size: 16px;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.author-role,
	.dates {
		color: var(--meta);
		font-size: 14px;
		line-height: 1.5;
	}

	.dates {
		margin: 0;
	}

	/* ---------- Cover ---------- */
	.cover {
		margin: 48px 0 0;
	}

	.cover :global(img) {
		width: 100%;
		height: 440px;
		border-radius: 16px;
		object-fit: cover;
	}

	.cover figcaption {
		margin-top: 8px;
		color: var(--meta);
		font-size: 13px;
	}

	.cover figcaption a {
		color: inherit;
	}

	/* ---------- Body ---------- */
	.body {
		max-width: 680px;
		margin: 64px auto 0;
	}

	.toc {
		margin-bottom: 40px;
		padding-top: 12px;
		border-top: 1px solid var(--line);
		font-size: 14px;
	}

	.toc summary {
		margin-bottom: 12px;
		color: var(--ink);
		font-weight: 500;
		cursor: pointer;
	}

	.toc ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toc li + li {
		margin-top: 8px;
	}

	.toc a {
		color: var(--muted);
		line-height: 1.35;
		text-decoration: none;
	}

	.toc a:hover {
		color: var(--ink);
		text-decoration: underline;
	}

	/* Article typography (shared .prose styles live in global.css) */
	.prose > :global(p:first-child) {
		color: var(--ink);
		font-size: clamp(1.15rem, 1.8vw, 1.3rem);
		line-height: 1.55;
	}

	.prose :global(a) {
		text-decoration-thickness: 1px;
	}

	/* ---------- Author box ---------- */
	.author-box {
		display: grid;
		grid-template-columns: 80px minmax(0, 1fr);
		gap: 24px;
		max-width: 680px;
		margin: 64px auto 0;
		padding: 32px;
		border-radius: 20px;
		background: var(--surface);
	}

	.author-box :global(img) {
		width: 80px;
		height: 80px;
		border-radius: 50%;
		object-fit: cover;
	}

	.box-text {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-width: 0;
	}

	.box-text p {
		margin: 0;
	}

	.box-label {
		color: var(--meta);
		font-size: 13px;
	}

	.box-name {
		color: var(--ink);
		font-size: 22px;
		font-weight: 500;
		line-height: 1.25;
	}

	.box-role {
		color: var(--meta);
		font-size: 14px;
	}

	.box-text .box-bio {
		margin-top: 8px;
		color: var(--muted);
		font-size: 16px;
		line-height: 1.5;
	}

	.box-text .box-links {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 8px;
		font-size: 15px;
	}

	.box-links a {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* ---------- < 1024px ---------- */
	@media (max-width: 1023px) {
		h1 {
			font-size: 44px;
		}

		.body,
		.author-box {
			max-width: none;
		}
	}

	/* ---------- < 768px ---------- */
	@media (max-width: 767px) {
		h1 {
			font-size: 32px;
		}

		.byline {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
		}

		.cover :global(img) {
			height: auto;
			aspect-ratio: 16 / 10;
		}

		.author-box {
			grid-template-columns: 64px minmax(0, 1fr);
			padding: 24px;
		}

		.author-box :global(img) {
			width: 64px;
			height: 64px;
		}
	}

	/* Phones: bigger tap areas in the table of contents */
	@media (max-width: 600px) {
		.toc {
			padding-top: 0;
		}

		.toc summary {
			margin-bottom: 0;
			padding: 12px 0;
		}

		.toc li + li {
			margin-top: 0;
		}

		.toc a {
			display: block;
			padding: 8px 0;
		}
	}
</style>
