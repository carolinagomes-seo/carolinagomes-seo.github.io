---
// A collapsible section built on native <details>/<summary> (no JavaScript; the content stays
// in the HTML). Used on the mobile About and Skills pages. Put it inside a wrapper with a top
// border; each section draws its own bottom border.
// The title is a heading for screen readers (role="heading") but not an <h2>: these pages also
// render the desktop layout with real <h2>s, and two copies of each <h2> confused the outline.
interface Props {
	title: string;
	// One-line summary shown under the title while the section is closed
	summary?: string;
	open?: boolean;
	// Keep the summary on one line with an ellipsis
	truncate?: boolean;
}

const { title, summary, open = false, truncate = false } = Astro.props;
---

<details class="collapsible" open={open}>
	<summary>
		<span class="sum-text">
			<span class="title" role="heading" aria-level="2">{title}</span>
			{summary && <span class:list={['oneline', { truncate }]}>{summary}</span>}
		</span>
		<svg class="i-plus" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
		<svg class="i-minus" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path></svg>
	</summary>
	<div class="content">
		<slot />
	</div>
</details>

<style>
	.collapsible {
		border-bottom: 1px solid var(--line);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 64px;
		padding: 10px 0;
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.sum-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.title {
		margin: 0;
		color: var(--ink);
		font-size: 19px;
		font-weight: 500;
		letter-spacing: 0;
		line-height: 1.3;
	}

	.oneline {
		color: var(--meta);
		font-size: 13px;
		line-height: 1.4;
	}

	.truncate {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.collapsible[open] .oneline {
		display: none;
	}

	summary svg {
		flex: none;
		fill: none;
		stroke: var(--ink);
		stroke-width: 2;
		stroke-linecap: round;
	}

	.i-minus,
	.collapsible[open] .i-plus {
		display: none;
	}

	.collapsible[open] .i-minus {
		display: block;
	}

	.content {
		padding-bottom: 20px;
	}
</style>
