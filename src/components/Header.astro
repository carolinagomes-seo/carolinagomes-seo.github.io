---
// Site header: sticky, logo on the left, links and a Contact button on the right.
// Below 768px only the logo stays here and MobileNav takes over.
// Add, remove or reorder pages in NAV_LINKS (src/consts.ts).
import MobileNav from './MobileNav.astro';
import { NAV_LINKS } from '../consts';
import { isActive } from '../utils/nav';

const links = NAV_LINKS.filter((link) => link.href !== '/contact/');
const contactCurrent = isActive(Astro.url.pathname, '/contact/');
---

<!-- Lets keyboard and screen-reader users jump past the navigation -->
<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
	<div class="container inner">
		<a href="/" class="brand" aria-label="Carolina Gomes home">
			<svg class="brand-mark" width="24" height="14" viewBox="0 0 24 14" aria-hidden="true">
				<circle cx="6" cy="7" r="6" />
				<rect x="10" y="6" width="6" height="2" />
				<circle cx="19" cy="7" r="4" />
			</svg>
			<span class="brand-name">Carolina Gomes</span>
			<span class="brand-tag">SEO &amp; Brand</span>
		</a>

		<nav class="nav" aria-label="Main">
			<ul class="links">
				{
					links.map((link) => (
						<li>
							<a href={link.href} aria-current={isActive(Astro.url.pathname, link.href) ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<a class="contact" href="/contact/" aria-current={contactCurrent ? 'page' : undefined}>Contact</a>
		</nav>
	</div>
</header>

<MobileNav />

<style>
	/* Hidden until it gets keyboard focus */
	.skip {
		position: fixed;
		top: 12px;
		left: 12px;
		z-index: 60;
		padding: 12px 20px;
		border-radius: 999px;
		background: var(--ink);
		color: #fafaf8;
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		transform: translateY(-200%);
	}

	.skip:focus-visible {
		transform: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 40;
		height: 80px;
		border-bottom: 1px solid var(--line-soft);
		background: rgba(239, 238, 235, 0.92);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 100%;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		color: var(--ink);
		text-decoration: none;
	}

	.brand-mark {
		fill: currentColor;
	}

	.brand-name {
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	/* Smaller descriptor next to the name, split by a thin rule */
	.brand-tag {
		padding-left: 8px;
		border-left: 1px solid var(--line-soft);
		color: var(--ink-2);
		font-size: 14px;
		white-space: nowrap;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: 32px;
	}

	.links {
		display: flex;
		gap: 32px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links a {
		color: var(--ink);
		font-size: 15px;
		text-decoration: none;
	}

	.links a:hover {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.links a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 8px;
	}

	.contact {
		display: inline-flex;
		align-items: center;
		height: 40px;
		padding: 0 24px;
		border-radius: 999px;
		background: var(--ink);
		color: #fafaf8;
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
	}

	.contact:hover {
		background: var(--ink-2);
		color: #fafaf8;
	}

	/* Mobile: logo only; the floating menu in MobileNav.astro replaces the nav */
	@media (max-width: 767px) {
		.site-header {
			height: 56px;
		}

		.brand-name {
			font-size: 17px;
		}

		.nav {
			display: none;
		}
	}

	/* Very narrow phones: the name only */
	@media (max-width: 359px) {
		.brand-tag {
			display: none;
		}
	}
</style>
