---
// Prints ONE JSON-LD script with an @graph: the WebSite and the Person (every page) plus any
// page-specific nodes passed in `nodes` (ProfilePage on About, BlogPosting + breadcrumb on posts...).
// Page nodes point to the Person by @id only, so it is printed once per page.
import { SITE_TITLE } from '../consts';
import { AUTHOR } from '../data/author';
import { ids, personNode } from '../utils/schema';

interface Props {
	nodes?: Record<string, unknown>[];
}

const { nodes = [] } = Astro.props;
const { person, website } = ids(Astro.site);

const graph = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': website,
			url: new URL('/', website).href,
			name: SITE_TITLE,
			alternateName: AUTHOR.name,
			inLanguage: 'en',
			publisher: { '@id': person },
		},
		await personNode(Astro.site),
		...nodes,
	],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
